from pymata4 import pymata4
import time

board = pymata4.Pymata4()

TIMER_B_RESET = 10

# D10 controls Timer B RESET
board.set_pin_mode_digital_output(TIMER_B_RESET)

try:
    while True:

        # -------------------------
        # 5 seconds: FLASHING
        # -------------------------
        # RESET HIGH = Timer B runs
        board.digital_write(TIMER_B_RESET, 1)

        time.sleep(5)

        # -------------------------
        # 5 seconds: SOLID ON
        # -------------------------
        # RESET LOW = Timer B reset
        # Output pin 9 goes LOW
        # LED stays ON
        board.digital_write(TIMER_B_RESET, 0)

        time.sleep(5)

except KeyboardInterrupt:

    # Leave Timer B reset
    # LED will remain ON
    board.digital_write(TIMER_B_RESET, 0)

    board.shutdown()
